// =====================================================
// Supply Chain & Inventory Dashboard - DAX Measures
// Tables: dim_products, dim_suppliers, dim_date,
//         fact_inventory_daily, fact_purchase_orders
// =====================================================

// ---------- Date table (Modeling > New table) ----------
dim_date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2025, 1, 1 ), DATE ( 2025, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Month No", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Quarter", "Q" & QUARTER ( [Date] )
)

// ---------- Sales / demand ----------
Units Demanded = SUM ( fact_inventory_daily[units_demanded] )
Units Sold     = SUM ( fact_inventory_daily[units_sold] )

Total Revenue =
SUMX ( fact_inventory_daily,
    fact_inventory_daily[units_sold] * RELATED ( dim_products[unit_price] ) )

COGS =
SUMX ( fact_inventory_daily,
    fact_inventory_daily[units_sold] * RELATED ( dim_products[unit_cost] ) )

Gross Margin % = DIVIDE ( [Total Revenue] - [COGS], [Total Revenue] )

Lost Sales Units = [Units Demanded] - [Units Sold]

Lost Revenue =
SUMX ( fact_inventory_daily,
    ( fact_inventory_daily[units_demanded] - fact_inventory_daily[units_sold] )
        * RELATED ( dim_products[unit_price] ) )

// ---------- Inventory ----------
Closing Stock Units =
CALCULATE ( SUM ( fact_inventory_daily[closing_stock] ),
    LASTDATE ( dim_date[Date] ) )

Inventory Value =
SUMX (
    VALUES ( dim_products[product_id] ),
    CALCULATE ( SUM ( fact_inventory_daily[closing_stock] ), LASTDATE ( dim_date[Date] ) )
        * MAX ( dim_products[unit_cost] ) )

Avg Inventory Value =
AVERAGEX ( VALUES ( dim_date[Date] ),
    SUMX ( VALUES ( dim_products[product_id] ),
        CALCULATE ( SUM ( fact_inventory_daily[closing_stock] ) )
            * MAX ( dim_products[unit_cost] ) ) )

Inventory Turnover = DIVIDE ( [COGS], [Avg Inventory Value] )

Days of Inventory = DIVIDE ( 365, [Inventory Turnover] )

// ---------- Stock availability ----------
Stockout Days = SUM ( fact_inventory_daily[stockout_flag] )

Stockout Rate % =
DIVIDE ( [Stockout Days], COUNTROWS ( fact_inventory_daily ) )

Fill Rate % = DIVIDE ( [Units Sold], [Units Demanded] )

Stock Availability % = 1 - [Stockout Rate %]

Below Reorder Point =
COUNTROWS (
    FILTER ( fact_inventory_daily,
        fact_inventory_daily[closing_stock]
            <= RELATED ( dim_products[reorder_point] ) ) )

// ---------- Supplier performance ----------
Delivered POs =
CALCULATE ( COUNTROWS ( fact_purchase_orders ),
    fact_purchase_orders[status] = "Delivered" )

On-Time POs =
CALCULATE ( COUNTROWS ( fact_purchase_orders ),
    fact_purchase_orders[status] = "Delivered",
    fact_purchase_orders[delivery_date] <= fact_purchase_orders[promised_date] )

On-Time Delivery % = DIVIDE ( [On-Time POs], [Delivered POs] )

Avg Delay Days =
AVERAGEX (
    FILTER ( fact_purchase_orders, fact_purchase_orders[status] = "Delivered" ),
    MAX ( 0, DATEDIFF ( fact_purchase_orders[promised_date],
                        fact_purchase_orders[delivery_date], DAY ) ) )

Avg Lead Time (Days) =
AVERAGEX (
    FILTER ( fact_purchase_orders, fact_purchase_orders[status] = "Delivered" ),
    DATEDIFF ( fact_purchase_orders[order_date],
               fact_purchase_orders[delivery_date], DAY ) )

Total Purchase Spend =
SUMX ( fact_purchase_orders,
    fact_purchase_orders[qty_ordered] * fact_purchase_orders[unit_cost] )

Open POs =
CALCULATE ( COUNTROWS ( fact_purchase_orders ),
    fact_purchase_orders[status] = "Open" )

// ---------- Conditional formatting helper ----------
Supplier Rating =
SWITCH ( TRUE (),
    [On-Time Delivery %] >= 0.9, "Excellent",
    [On-Time Delivery %] >= 0.75, "Good",
    "Needs Improvement" )
